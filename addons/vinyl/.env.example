# Secrets and settings for the `vinyl` addon. Copy this file to `.env` in
# this directory before you run `make up ADDON=vinyl` or `make up-dev ADDON=vinyl`.

# The release of the vinyl image compose runs. Set it to take another
# release. The releases are at https://github.com/jakehigg/joshua-addons/releases
JOSHUA_ADDONS_VERSION=0.1.3

# The compose network joshua-ai created. Set this only when joshua-ai's
# project name is not the default `joshua-ai` (the network would then not be
# `joshua-ai_default`).
#JOSHUA_NETWORK=joshua-ai_default

# When set, every request to /mcp needs `Authorization: Bearer <ADDON_TOKEN>`.
# Set the same value here and for VINYL_ADDON_TOKEN in joshua-ai's .env.
ADDON_TOKEN=

# A Discogs personal access token, from the "Generate token" button at
# https://www.discogs.com/settings/developers. The sync reads the collection
# with it and never writes. Without it, the addon serves what it has and the
# nightly sync stays off.
DISCOGS_TOKEN=

# The Discogs username whose collection to read. Leave it empty and the addon
# asks Discogs which account the token belongs to.
#DISCOGS_USERNAME=

# The local time of the nightly sync, as HH:MM. Empty turns the schedule off.
#VINYL_SYNC_TIME=03:00

# The ISO currency code the market price is quoted in. The default is USD.
#VINYL_CURRENCY=USD

# The User-Agent the addon sends to Discogs and MusicBrainz. Both refuse a
# request without a descriptive one. The default names this addon.
#VINYL_USER_AGENT=

# The shelf rules file: the facet list, the sections after Z, and the manual
# overrides. Uncomment the bind mount in docker-compose.yml with this. With
# no file, the defaults apply.
#VINYL_CONFIG=/etc/joshua-addon/shelf.json

# The timezone the nightly sync reads VINYL_SYNC_TIME in. A container has no
# timezone of its own, so without this "03:00" means 03:00 UTC.
#TZ=America/New_York

# The log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. The default is INFO.
#LOG_LEVEL=INFO
