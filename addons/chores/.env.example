# Secrets and settings for the `chores` addon. Copy this file to `.env` in
# this directory before you run `make up ADDON=chores` or `make up-dev ADDON=chores`.
# The container gets no variable that this file does not name.
# To set XP_PER_DOLLAR, COOLDOWN_SECONDS, MANAGER_LABEL, CHORES_TZ, or
# CHORES_STATIC_DIR, add the variable to the `environment:` block of the
# service. The README of the addon tells what each variable does.

# The release of the chores image compose runs. Set it to take another
# release. The releases are at https://github.com/jakehigg/joshua-addons/releases
JOSHUA_ADDONS_VERSION=0.1.3

# The compose network joshua-ai created. Set this only when joshua-ai's
# project name is not the default `joshua-ai` (the network would then not be
# `joshua-ai_default`).
#JOSHUA_NETWORK=joshua-ai_default

# When set, every request to /mcp needs `Authorization: Bearer <ADDON_TOKEN>`.
# Set the same value here and for CHORES_ADDON_TOKEN in joshua-ai's .env.
ADDON_TOKEN=

# The manager PIN. The manager view sends it as `Authorization: Bearer <MANAGER_PIN>`
# on each manager route under /api. When it is empty, each manager route gets
# 503. Keep it secret.
MANAGER_PIN=

# A full Postgres URL (for example postgresql://user:pass@host:5432/chores).
# When set, the addon uses Postgres, not the SQLite file, and it does not use
# the `chores-data` volume.
#DATABASE_URL=

# The SQLite file, when DATABASE_URL is not set. It is on the `chores-data`
# volume at /data. Change it only when you also change the volume mount in
# docker-compose.yml.
#CHORES_DB=/data/chores.db

# The log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL. The default is INFO.
#LOG_LEVEL=INFO
