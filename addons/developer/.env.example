# Secrets and settings for the `developer` addon (joshua-developer). Copy this
# file to `.env` in this directory before you run `make up ADDON=developer` or
# `make up-dev ADDON=developer`.

# The release of the joshua-developer image compose runs. The releases are at
# https://github.com/jakehigg/joshua-addons/releases
JOSHUA_ADDONS_VERSION=0.1.3

# The compose network joshua-ai created. Set it only when joshua-ai's project
# name is not the default `joshua-ai`.
#JOSHUA_NETWORK=joshua-ai_default

# One bearer token for each person, as person=token pairs:
# alex=<token>,mia=<token>. Each person must be in `people` in developer.yaml.
# The gateway sends the person's token on that person's connection.
DEVELOPER_TOKENS=

# A bearer token with no person. It can read tasks and personas, and it
# cannot start a task.
ADDON_TOKEN=

# Where a task report goes. Set both, or neither. JOSHUA_TOKEN_DEVELOPER is
# the fleet token joshua-ai knows for the identity `developer`.
CHANNELS_URL=
JOSHUA_TOKEN_DEVELOPER=

# The Claude token. The manager keeps it and puts it on each request a
# worker sends through the Claude forwarder. It never goes into a worker.
CLAUDE_CODE_OAUTH_TOKEN=

# The runtime that starts a worker. `docker` starts one container for each
# task, through the Docker socket proxy in docker-compose.yml. `stub` starts
# no worker and records a fake report.
WORKER_RUNTIME=docker

# The worker image. The default is the worker of JOSHUA_ADDONS_VERSION. Use
# the worker of the same release as the manager.
#WORKER_IMAGE=ghcr.io/jakehigg/joshua-addons-developer-worker:<version>

# The network a worker also joins when developer.yaml has `network: on`.
#PUBLIC_NETWORK=bridge

# A CA bundle to trust for a git host with a private certificate authority.
# Mount the file into the container, and give its path here.
#GIT_CA_BUNDLE=/etc/ssl/certs/git-host-ca.pem

# The seconds a worker has from its start to its first brief call. A worker
# that takes longer is stopped, and its task fails.
#WORKER_START_GRACE_S=600

# The git tokens that developer.yaml names with token_env. A worker gets the
# token of its task's host. Give each token access only to the repositories
# in the lists. For example:
#GITHUB_TOKEN=
#GITLAB_TOKEN=
# A person's own token, for a `people.<id>.platforms` entry. The host then
# shows that person as the author of the push and the pull request.
#GITHUB_TOKEN_ALEX=
#GITLAB_TOKEN_ALEX=

# The log level of the manager.
#LOG_LEVEL=INFO
