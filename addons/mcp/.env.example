# Secrets and settings for the `mcp` addon (joshua-mcp). Copy this file to `.env` in
# this directory before you run `make up ADDON=mcp` or `make up-dev ADDON=mcp`.

# The release of the joshua-mcp image compose runs. The releases are at
# https://github.com/jakehigg/joshua-addons/releases
JOSHUA_ADDONS_VERSION=0.1.3

# The compose network and the data volume joshua-ai created. Set these only
# when joshua-ai's project name is not the default `joshua-ai`.
#JOSHUA_NETWORK=joshua-ai_default
#JOSHUA_DATA_VOLUME=joshua-ai_data

# The host port for /mcp. A caller outside Docker, such as Claude Code, uses it.
#MCP_PORT=8000

# The bearer tokens. Set at least one before you publish the port.
# ADDON_TOKEN is the token for the caller `addon`. MCP_TOKENS gives one
# token to each caller, as name=token pairs: laptop=<token>,laptop-ci=<token>
ADDON_TOKEN=
MCP_TOKENS=

# The callers that can only read, separated by commas.
MCP_READONLY=

# The timezone that sets "today" for the journal. Use the timezone in joshua.yaml.
MCP_TIMEZONE=UTC
